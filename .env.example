# Copy to .env and fill in. .env is git-ignored.

# Root of the source document archive (read-only input to extraction).
ARCHIVE_ROOT=X:\path\to\document\archive

# Working directory: holds chroma/, corpus*.jsonl, evalset*.jsonl, results_*.json.
RAG_DIR=C:\Rag

# LM Studio OpenAI-compatible API base. Endpoints are appended to this.
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Model ids exactly as LM Studio reports them.
EMBED_MODEL=text-embedding-bge-m3
CHAT_MODEL=qwen3.5-9b

# Separate generator for the Armenian eval set - gen_arm.py only.
ARM_CHAT_MODEL=armeniangpt-1.0-3b
