# Copy to .env and fill in. .env is git-ignored.

# Root of the source document archive (read-only input to extraction).
ARCHIVE_ROOT=X:\path\to\document\archive

# Working directory: holds chroma/, corpus*.jsonl, evalset*.jsonl, results_*.json.
RAG_DIR=C:\Rag

# LM Studio OpenAI-compatible API base. Endpoints are appended to this.
LM_STUDIO_URL=http://127.0.0.1:1234/v1

# Model ids exactly as LM Studio reports them.
EMBED_MODEL=text-embedding-bge-m3
CHAT_MODEL=qwen3.5-9b

# Separate generator for the Armenian eval set - gen_arm.py only.
ARM_CHAT_MODEL=armeniangpt-1.0-3b

# --- Docker only -----------------------------------------------------------
# Host directory bind-mounted at /data (corpus, chroma/, eval sets, results).
# Defaults to the directory holding docker-compose.yml.
RAG_DATA=.

# Host HuggingFace cache, bind-mounted so the 2.27 GB reranker is not
# re-downloaded on every `--rm` run. Point this at your own cache:
#   Windows  C:/Users/<you>/.cache/huggingface
#   Linux    /home/<you>/.cache/huggingface
#   macOS    /Users/<you>/.cache/huggingface
# Leave it unset and Compose falls back to a named volume named `hf-cache`,
# which works on every platform but starts empty, so the first run downloads.
HF_CACHE=hf-cache
